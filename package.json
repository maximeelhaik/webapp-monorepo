{
  "name": "new-app-ia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync": "node scripts/sync.js",
    "postinstall": "npm run sync",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "npm run build --workspace=@new-app-ia/adjectif",
    "preview": "npm run preview --workspace=@new-app-ia/adjectif",
    "clean": "npm run clean --workspace=@new-app-ia/adjectif",
    "lint": "npm run lint --workspace=@new-app-ia/adjectif",
    "dev:world": "npm run sync && APP=world vite",
    "build:world": "npm run sync && npm run build --workspace=@new-app-ia/world",
    "dev:constellation": "npm run sync && APP=constellation vite",
    "build:constellation": "npm run sync && npm run build --workspace=@new-app-ia/constellation"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.0",
    "@vercel/node": "^5.7.11",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
